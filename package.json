{
  "name": "server",
  "version": "0.1.0",
  "description": "Monster Hunter Explore Private Server",
  "main": "server.js",
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5",
    "@types/node": "^26",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "commitizen": "^4.3.2",
    "cross-env": "^10",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.4",
    "rimraf": "^6",
    "supertest": "^7.2.2",
    "tsx": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "bufferutil": "^4.0.8",
    "crc": "^4.3.2",
    "dotenv": "^17",
    "egoroof-blowfish": "^4.0.2",
    "express": "^5",
    "express-winston": "^4.2.0",
    "mongoose": "^9",
    "socket.io": "4",
    "winston": "^3.10.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "install:clean": "cross-env rimraf node_modules/ yarn.lock && yarn install",
    "clean": "rimraf dist",
    "build": "yarn clean && tsc -p tsconfig.build.json && ln -sfn ../src/public dist/public && cp -r src/json dist/json && cp -r src/csv dist/csv",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "generate-island": "tsx src/services/oceanService.ts",
    "generate-questList": "tsx src/services/questList.ts",
    "bf-dec": "tsx src/bin/testDecryption.ts",
    "start:dev": "nodemon ./src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "proxy": "tsx src/proxy/main.ts",
    "fpk": "tsx src/tools/fpk/main.ts",
    "setup": "tsx src/tools/setup/main.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
