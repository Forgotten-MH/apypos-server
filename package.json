{
  "name": "server",
  "version": "1.0.0",
  "description": "Monster Hunter Explore Private Server",
  "main": "server.js",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.0.0",
    "commitizen": "^4.3.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.0.1",
    "eslint-config-standard-with-typescript": "^39.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-promise": "^6.0.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "bufferutil": "^4.0.8",
    "crc": "^4.3.2",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-winston": "^4.2.0",
    "mongoose": "^8.6.0",
    "socket.io": "4",
    "winston": "^3.10.0"
  },
  "scripts": {
    "install:clean": "cross-env rimraf node_modules/ yarn.lock && yarn install",
    "clean": "rimraf dist",
    "build": "yarn clean && tsc",
    "dev": "ts-node server.ts",
    "start": "node --openssl-legacy-provider dist/server.js",
    "generate-island": "node --openssl-legacy-provider -r ts-node/register src/services/oceanService.ts",
    "generate-questList": "node --openssl-legacy-provider -r ts-node/register src/services/questList.ts",
    "bf-dec": "node --openssl-legacy-provider -r ts-node/register src/bin/testDecryption.ts",
    "start:dev": "nodemon  --openssl-legacy-provider ./src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
