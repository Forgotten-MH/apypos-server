{
  "name": "server",
  "version": "1.0.0",
  "description": "Monster Hunter Explore Private Server",
  "main": "server.js",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "commitizen": "^4.3.0",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "bufferutil": "^4.0.8",
    "crc": "^4.3.2",
    "dotenv": "^16.4.7",
    "egoroof-blowfish": "^4.0.2",
    "express": "^4.18.2",
    "express-winston": "^4.2.0",
    "mongoose": "^8.6.0",
    "socket.io": "4",
    "winston": "^3.10.0"
  },
  "scripts": {
    "install:clean": "cross-env rimraf node_modules/ yarn.lock && yarn install",
    "clean": "rimraf dist",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "dev": "ts-node server.ts",
    "start": "node dist/server.js",
    "generate-island": "node -r ts-node/register src/services/oceanService.ts",
    "generate-questList": "node -r ts-node/register src/services/questList.ts",
    "bf-dec": "node -r ts-node/register src/bin/testDecryption.ts",
    "start:dev": "nodemon ./src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
