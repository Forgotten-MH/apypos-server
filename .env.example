# Server
# IP: bind address (0.0.0.0 = all interfaces)
# WEB_URL/RES_URL: must be reachable by the game client (use your LAN IP, not localhost)
IP=0.0.0.0
PORT=80
WEB_URL=http://192.168.1.100/web
RES_URL=http://192.168.1.100/

# MongoDB
DB_IP=127.0.0.1
DB_PORT=27017
DB_NAME=apypos
DB_USER=root
DB_PASSWORD=example

# Maintenance
API_NOT_AVAILABLE_MAINTENANCE=false
IS_MAINTENANCE=false

# Debug (logs full request/response bodies when true)
DEBUG=false

# SSL/TLS (only used when PORT=443)
# SSL_KEY_PATH=/etc/ssl/private/private.key
# SSL_CERT_PATH=/etc/ssl/certs/certificate.crt
# SSL_CA_PATH=/etc/ssl/certs/ca.crt
